{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sod-modern.devkit.local/contracts/feature-intent.v1.schema.json",
  "title": "SoD Modern Feature Intent v1",
  "description": "Structured, LLM-first feature intent. Operations are typed JSON IR and never accept raw Python tuple or expression source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "status", "description", "entrypoints", "changes", "verification"],
  "properties": {
    "schema": {"const": "sod-modern.feature-intent.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,119}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"enum": ["active", "draft", "disabled"]},
    "description": {"type": "string", "maxLength": 2000},
    "blueprint_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,119}$"},
    "entrypoints": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "pattern": "^entrypoint:"}, "uniqueItems": true},
    "changes": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "require_blueprint"],
      "properties": {
        "tests": {"type": "array", "maxItems": 24, "items": {"type": "string", "pattern": "^build/test_[A-Za-z0-9_]+\\.py$"}, "uniqueItems": true},
        "require_blueprint": {"type": "boolean"}
      }
    }
  }
}

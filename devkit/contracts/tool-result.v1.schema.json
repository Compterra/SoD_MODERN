{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sod-modern.devkit.local/contracts/tool-result.v1.schema.json",
  "title": "SoD Modern DevKit Tool Result v1",
  "description": "Stable envelope returned by DevKit MCP tools, including read-only diagnostics, strict release-gate, Module Blueprint, Feature Authoring, and Content Forge contract evidence, plus explicitly named SHA-guarded modular-source, deterministic dialogue-creation, typed feature/content-pack plan, and narrowly scoped legacy compile-authoring edit operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tool",
    "ok",
    "data",
    "provenance",
    "warnings"
  ],
  "properties": {
    "contract_version": {
      "const": "devkit.tool-result.v1"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_root",
        "read_only",
        "server_version"
      ],
      "properties": {
        "repo_root": {
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        },
        "server_version": {
          "type": "string"
        },
        "mcp_sdk_version": {
          "type": "string"
        },
        "compiled_dialogue": {
          "type": ["string", "null"]
        },
        "source_is_newer": {
          "type": ["boolean", "null"]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
